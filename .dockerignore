# Control de versiones
.git
.gitignore
.gitattributes

# Dependencias (se instalan dentro de la imagen)
node_modules
vendor

# Assets generados (se compilan dentro de la imagen)
public/build
public/hot
public/storage

# Cachés y logs de Laravel
bootstrap/cache/*
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/app/*
storage/*.key

# Entornos (nunca meter secretos en la imagen)
.env
.env.*
!.env.docker.example

# Documentación y archivos de desarrollo
docs
tests
README.md
docker-compose.yml
*.log
.phpunit.result.cache
