# Plantilla de entorno para Docker.
#
# El entrypoint copia este archivo a .env automáticamente si no existe y
# genera el APP_KEY. En docker-compose.yml estas variables se pasan como
# variables de entorno reales, que tienen prioridad sobre el .env.
#
# Puedes copiarlo a .env si quieres personalizarlo:
#   cp .env.docker.example .env

APP_NAME=ObraOS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CO
APP_TIMEZONE=America/Bogota

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=obras
DB_USERNAME=obras
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

MAIL_MAILER=log
